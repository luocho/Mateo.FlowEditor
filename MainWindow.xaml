<Window x:Class="FlowEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FlowEditor.ViewModels"
        xmlns:framework="clr-namespace:Framework"
        Title="{Binding Title}" Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding LoadDllCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteNodeCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- 菜单栏 -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="打开(_O)..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="保存(_S)" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="另存为(_A)..." Command="{Binding SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="退出(_X)" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="{Binding Editor.UndoName, StringFormat=撤销(_U) {0}, FallbackValue=撤销(_U)}"
                          Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="{Binding Editor.RedoName, StringFormat=重做(_R) {0}, FallbackValue=重做(_R)}"
                          Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="全选(_A)" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A"/>
                <MenuItem Header="删除选中节点(_D)" Command="{Binding DeleteNodeCommand}" InputGestureText="Delete"/>
            </MenuItem>
            <MenuItem Header="流程(_P)">
                <MenuItem Header="新建流程(_N)" Command="{Binding AddFlowCommand}"/>
                <MenuItem Header="删除当前流程(_D)" Command="{Binding RemoveFlowCommand}"/>
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="加载任务 DLL(_L)..." Command="{Binding LoadDllCommand}" InputGestureText="Ctrl+D"/>
                <Separator/>
                <MenuItem Header="校验配置(_V)" Command="{Binding ValidateCommand}"/>
            </MenuItem>
        </Menu>

        <!-- 状态栏：左=统计信息，右=缩放控制 -->
        <Border DockPanel.Dock="Bottom" Background="#FFF2F3F5"
                BorderBrush="#FFDCDFE6" BorderThickness="0,1,0,0" Padding="10,3">
            <Grid>
                <TextBlock VerticalAlignment="Center" Foreground="#FF606266"
                           Text="{Binding Editor.StatusText}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="缩放" VerticalAlignment="Center" Foreground="#FF909399"/>
                    <Button Content="−" Width="24" Margin="6,0,0,0" Click="ZoomOut_Click"/>
                    <Slider Width="130" Margin="6,0" VerticalAlignment="Center"
                            Minimum="0.25" Maximum="2.5"
                            Value="{Binding Editor.Zoom, Mode=TwoWay}"/>
                    <Button Content="＋" Width="24" Click="ZoomIn_Click"/>
                    <Button Content="100%" Margin="6,0,0,0" Padding="6,0" Click="ZoomReset_Click"/>
                    <TextBlock Width="46" Margin="6,0,0,0" VerticalAlignment="Center"
                               Text="{Binding Editor.Zoom, StringFormat=P0}"/>
                    <TextBlock Text="（Ctrl+滚轮）" VerticalAlignment="Center" Foreground="#FFC0C4CC" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：Flow 列表 -->
            <DockPanel Grid.Column="0" Background="#FFF2F3F5">
                <Border DockPanel.Dock="Top" Padding="10,8" Background="#FFE4E7ED">
                    <TextBlock Text="Flow 列表" FontWeight="Bold"/>
                </Border>
                <ListBox ItemsSource="{Binding Flows}"
                         SelectedItem="{Binding SelectedFlow}"
                         BorderThickness="0" Background="Transparent" Padding="4">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" Padding="2">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                        RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="修改流程名称" Click="RenameFlowMenu_Click"/>
                                        <MenuItem Header="删除流程" Click="DeleteFlowMenu_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#FF909399"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#FFDCDFE6"/>

            <!-- 中间：画板 -->
            <Grid Grid.Column="2">
                <!-- 滚动区域 -->
                <ScrollViewer x:Name="CanvasScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="CanvasScroll_PreviewMouseWheel">

                    <Grid x:Name="EditorArea" ClipToBounds="True"
                          Width="{Binding Editor.CanvasWidth}"
                          Height="{Binding Editor.CanvasHeight}"
                          ContextMenuOpening="EditorArea_ContextMenuOpening"
                          MouseLeftButtonDown="EditorArea_MouseLeftButtonDown"
                          MouseMove="EditorArea_MouseMove"
                          MouseLeftButtonUp="EditorArea_MouseLeftButtonUp">
                        <!-- 点阵背景 -->
                        <Grid.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Brush="#FFD8DCE3">
                                        <GeometryDrawing.Geometry>
                                            <EllipseGeometry Center="10,10" RadiusX="1.1" RadiusY="0.8"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Grid.Background>
                        <!-- 缩放变换 -->
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding Editor.Zoom}" ScaleY="{Binding Editor.Zoom}"/>
                        </Grid.LayoutTransform>
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="添加 ACTION 节点" Click="AddActionNode_Click"/>
                                <MenuItem Header="添加 FLOW 节点" Click="AddFlowStepNode_Click"/>
                            </ContextMenu>
                        </Grid.ContextMenu>

                        <!-- 连线层 -->
                        <ItemsControl ItemsSource="{Binding Editor.Connections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                                    <Grid PreviewMouseLeftButtonDown="Connection_MouseLeftButtonDown" Cursor="Hand">
                                        <Path Stroke="Transparent" StrokeThickness="14" Data="{Binding Geometry}">
                                            <Path.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="删除连线" Click="DeleteConnection_Click"/>
                                                </ContextMenu>
                                            </Path.ContextMenu>
                                        </Path>
                                        <Path StrokeThickness="2" Data="{Binding Geometry}" IsHitTestVisible="False">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="#FF909399"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Stroke" Value="#FF409EFF"/>
                                                            <Setter Property="StrokeThickness" Value="3"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <Canvas>
                                            <Border Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                                    Background="#E6FFFFFF" CornerRadius="3" Padding="5,2">
                                                <TextBlock Width="86" Text="{Binding Conditions}"
                                                           TextAlignment="Center" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </Canvas>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 节点层 -->
                        <ItemsControl ItemsSource="{Binding Editor.Nodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X, Mode=OneWay}"/>
                                    <Setter Property="Canvas.Top"  Value="{Binding Y, Mode=OneWay}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                                    <Border Width="180" Background="{Binding BodyBrush}" CornerRadius="7"
                                            BorderThickness="1.5"
                                            PreviewMouseLeftButtonDown="Node_MouseLeftButtonDown"
                                            SizeChanged="Node_SizeChanged">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#FFC0C4CC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FF409EFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25"/>
                                        </Border.Effect>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="添加 ACTION 节点" Click="AddActionNode_Click"/>
                                                <MenuItem Header="添加 FLOW 节点" Click="AddFlowStepNode_Click"/>
                                                <Separator/>
                                                <MenuItem Header="删除节点" Click="DeleteNodeMenu_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="{Binding HeaderBrush}"
                                                    CornerRadius="6,6,0,0" Padding="9,5">
                                                <TextBlock Text="{Binding Id, StringFormat=ID {0}}" Foreground="White"
                                                           FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="10,10"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <Ellipse x:Name="InPort" Grid.RowSpan="2" Width="11" Height="11"
                                                     Fill="#FF67C23A" Stroke="White" StrokeThickness="1.5"
                                                     HorizontalAlignment="Center" VerticalAlignment="Top"
                                                     Margin="0,-6,0,0" Panel.ZIndex="1" Cursor="Cross" ToolTip="输入端口"/>
                                            <Ellipse x:Name="OutPort" Grid.RowSpan="2" Width="11" Height="11"
                                                     Fill="#FF409EFF" Stroke="White" StrokeThickness="1.5"
                                                     HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                     Margin="0,0,0,-6" Panel.ZIndex="1" Cursor="Cross" ToolTip="按住拖出连线"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 框选/拖线覆盖层：Canvas 子元素才能用 Canvas.Left/Top 精确定位 -->
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="SelectionRect" Visibility="Collapsed"
                                       Stroke="#FF409EFF" StrokeThickness="1" StrokeDashArray="4 2"
                                       Fill="#1A409EFF"/>
                            <Line x:Name="TempLine" Stroke="#FF409EFF" StrokeThickness="2"
                                  StrokeDashArray="4 3" Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#FFDCDFE6"/>

            <!-- 右侧：节点/连线属性 -->
            <Border Grid.Column="4" Background="#FFFAFAFA" Padding="14">
                <Grid>
                    <TextBlock Text="请选择节点或连线" Foreground="#FF909399"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.Editor.SelectedNode,
                                                RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding DataContext.Editor.SelectedConnection,
                                                RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding Editor.SelectedNode}">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <TextBlock Text="节点属性" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                            <TextBlock Text="Id" Foreground="#FF606266"/>
                            <TextBox Text="{Binding Id, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,10"/>

                            <TextBlock Text="Name" Foreground="#FF606266"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                            <TextBlock Text="StepType" Foreground="#FF606266"/>
                            <ComboBox ItemsSource="{Binding DataContext.Editor.StepTypeOptions,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding StepType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="StepTypeSelector_SelectionChanged"
                                      Margin="0,4,0,10"/>

                            <TextBlock Text="{Binding RunTypeLabel}" Foreground="#FF606266"/>
                            <ComboBox IsEditable="True"
                                      Text="{Binding RunType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="RunTypeSelector_SelectionChanged"
                                      DropDownClosed="RunTypeSelector_DropDownClosed"
                                      Margin="0,4,0,10">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.TaskTypes,
                                            RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StepType}" Value="{x:Static framework:FlowStepType.Flow}">
                                                <Setter Property="ItemsSource" Value="{Binding DataContext.FlowTargets,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <TextBlock Text="节点颜色" Foreground="#FF606266"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding HeaderBrush}" BorderBrush="#FFBFC4CC"
                                        BorderThickness="1" CornerRadius="3" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" Text="{Binding ConfiguredColor, Mode=OneWay}"
                                         IsReadOnly="True"/>
                            </Grid>
                            <TextBlock Text="颜色由 appsettings.json 的 NodeColors 配置" FontSize="11"
                                       Foreground="#FF909399" Margin="0,5,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding Editor.SelectedConnection}">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <TextBlock Text="连线属性" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                            <TextBlock Text="FromStepId" Foreground="#FF606266"/>
                            <TextBox Text="{Binding FromStepId, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,10"/>

                            <TextBlock Text="NextStepId" Foreground="#FF606266"/>
                            <TextBox Text="{Binding NextStepId, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,10"/>

                            <TextBlock Text="NextStepConditions" Foreground="#FF606266"/>
                            <ComboBox IsEditable="True"
                                      ItemsSource="{Binding DataContext.Editor.ConditionOptions,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                      Text="{Binding Conditions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="ConnectionConditionSelector_SelectionChanged"
                                      DropDownClosed="ConnectionConditionSelector_DropDownClosed"
                                      Margin="0,4,0,10"/>

                            <TextBlock Text="NextStepRunType" Foreground="#FF606266"/>
                            <TextBox Text="{Binding RunType, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
